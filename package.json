{
  "name": "safe-space-app",
  "version": "1.0.0",
  "scripts": {
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install",
    "build-client": "cd client && npm run build",
    "start": "cd server && node index.js",
    "build": "npm run vercel-build",
    "vercel-build": "cd client && npm install && npm run build && cd .. && rm -rf public dist && mkdir -p public dist && cp -r client/dist/* public/ && cp -r client/dist/* dist/ && cd server && npm install --legacy-peer-deps"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@playwright/test": "^1.57.0",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "dotenv": "^17.4.2",
    "mongodb": "^7.2.0",
    "playwright": "^1.57.0"
  }
}
